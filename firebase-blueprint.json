{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "An airline ticket reconciliation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNo": { "type": "string" },
        "source": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number", "description": "Ticket amount" },
        "reqNum": { "type": "string" },
        "pnr": { "type": "string" },
        "isDuplicate": { "type": "boolean" },
        "userId": { "type": "string", "description": "The UID of the user who owns this record" }
      },
      "required": ["id", "ticketNo", "source", "date", "amount", "userId"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Stores user tickets for reconciliation."
    }
  }
}
