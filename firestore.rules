rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'ticketNo', 'source', 'date', 'amount', 'userId']) &&
             data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.ticketNo is string && data.ticketNo.size() <= 128 &&
             data.source is string && data.source.size() <= 64 &&
             data.date is string && data.date.size() <= 32 &&
             data.amount is number &&
             (data.get('reqNum', '') is string) && (data.get('reqNum', '').size() <= 128) &&
             (data.get('pnr', '') is string) && (data.get('pnr', '').size() <= 128) &&
             (data.get('isDuplicate', false) is bool);
    }
    
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(ticketId) && 
                    isValidTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'reqNum', 'pnr', 'isDuplicate', 'source', 'date', 'amount', 'ticketNo', 'userId', 'id'
                    ]);
      allow delete: if isSignedIn() && isValidId(ticketId) && existing().userId == request.auth.uid;
    }
    match /vendorBalances/{balanceId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(balanceId) && 
                    incoming().userId == request.auth.uid && 
                    incoming().keys().hasAll(['id', 'vendorName', 'initialBalance', 'userId']);
      allow update: if isSignedIn() && isValidId(balanceId) && 
                    incoming().userId == existing().userId &&
                    incoming().keys().hasAll(['id', 'vendorName', 'initialBalance', 'userId']);
      allow delete: if isSignedIn() && isValidId(balanceId) && existing().userId == request.auth.uid;
    }
  }
}
